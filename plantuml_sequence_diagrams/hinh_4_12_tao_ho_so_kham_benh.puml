@startuml
title Hình 4.12. Sơ đồ trình tự tạo hồ sơ khám bệnh
hide footbox
autonumber
skinparam dpi 220
skinparam shadowing false
skinparam defaultFontName Arial
scale 0.9

actor "Bác sĩ" as Doctor
boundary "DoctorMedicalRecordsPage.jsx" as UI
control "API Client" as API
control "medicalRecordRoutes\nPOST /api/medical-records" as Route
control "auth + roleMiddleware\n(doctor)" as Auth
control "validate\ncreateMedicalRecordRules" as Validate
control "MedicalRecordController\ncreateMedicalRecord()" as Controller
database "MongoDB\nAppointment" as AppointmentDB
database "MongoDB\nMedicalRecord" as RecordDB
control "NotificationService" as Notify
control "EmailService" as Email
control "AuditLogger" as Audit
control "SocketService" as Socket

Doctor -> UI : Nhập chẩn đoán, kết luận,\nđơn thuốc và lưu hồ sơ
UI -> API : POST /api/medical-records\n{appointmentId, diagnosis,...}
API -> Route : Chuyển request
Route -> Auth : Kiểm tra JWT và role doctor
Auth -> Validate : Kiểm tra dữ liệu đầu vào
Validate -> Controller : createMedicalRecord()

Controller -> Controller : Kiểm tra role bác sĩ\nvà doctorId
alt Không phải bác sĩ / thiếu doctorId
  Controller --> UI : 403 / 400\nThông báo lỗi
else Hợp lệ
  Controller -> AppointmentDB : findById(appointmentId)
  AppointmentDB --> Controller : appointment

  alt Không tìm thấy lịch hẹn / không thuộc bác sĩ
    Controller --> UI : 404 / 403\nThông báo lỗi
  else Đã có hồ sơ cho lịch hẹn này
    Controller -> RecordDB : findOne({ appointmentId })
    RecordDB --> Controller : existing record
    Controller --> UI : 200 OK\nTrả hồ sơ đã tồn tại
  else Lịch hẹn chưa ở trạng thái in_progress
    Controller --> UI : 400 Bad Request\nChỉ tạo khi đang khám
  else Tạo hồ sơ thành công
    Controller -> RecordDB : create(medicalRecord)

    Controller -> AppointmentDB : update status = completed\nconsultationStatus = completed\ncompletedAt = now
    AppointmentDB --> Controller : saved

    opt Có chỉ định tái khám
      Controller -> Notify : syncFollowUpStatusForAppointment()
    end

    Controller -> Notify : notifyPatientMedicalRecordCreated()
    Controller -> Notify : notifyPatientFollowUpRecommended()
    Controller -> Notify : notifyPatientReviewAvailable()
    Controller -> Email : sendMedicalRecordUpdatedEmail()
    Controller -> Audit : CREATE_MEDICAL_RECORD
    Controller -> Socket : emitAppointmentUpdated()

    Controller --> UI : 201 Created\nmedicalRecord + appointment
  end
end

@enduml
